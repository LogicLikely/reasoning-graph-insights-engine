{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:all": "vitest run",
    "storybook:test": "storybook dev -p 6006 --ci --quiet",
    "cucumber:dry": "npx cross-env TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js cucumber/features/**/*.feature --loader ts-node/esm --import cucumber/support/world.ts --import cucumber/support/hooks.ts --import cucumber/steps/**/*.ts --dry-run",
    "cucumber": "wait-on http://127.0.0.1:6006/iframe.html && npx cross-env TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js cucumber/features/**/*.feature --loader ts-node/esm --import cucumber/support/world.ts --import cucumber/support/hooks.ts --import cucumber/steps/**/*.ts",
    "cucumber:headed": "wait-on http://127.0.0.1:6006/iframe.html && npx cross-env BDD_HEADLESS=false TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js cucumber/features/**/*.feature --loader ts-node/esm --import cucumber/support/world.ts --import cucumber/support/hooks.ts --import cucumber/steps/**/*.ts",
    "func": "start-server-and-test storybook:test http://127.0.0.1:6006/iframe.html cucumber",
    "func:headed": "start-server-and-test storybook:test http://127.0.0.1:6006/iframe.html cucumber:headed",
    "test:cucumber": "npm run cucumber",
    "test:cucumber:headed": "npm run cucumber:headed",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic"
  },
  "dependencies": {
    "@logiclikely/graphmap": "file:vendor/logiclikely-graphmap-0.2.0-next.2.tgz",
    "@xyflow/react": "^12.8.5",
    "axios": "^1.12.2",
    "dagre": "^0.8.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chromatic": "^17.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.0",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "mockdate": "^3.0.5",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.60.0",
    "start-server-and-test": "^2.1.2",
    "storybook": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
