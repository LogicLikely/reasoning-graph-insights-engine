<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\backend\backend.csproj" />
    <ProjectReference Include="..\backend.AnalysisWorker\backend.AnalysisWorker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\backend\data\sql\benchmark_schema.sql"
             Link="data\sql\benchmark_schema.sql"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\frontend\performance\run-browser-journey.mjs"
             Link="browser\run-browser-journey.mjs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
