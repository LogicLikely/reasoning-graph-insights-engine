<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.14" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\docs\contracts\insights-lab\run-export-v1.schema.json"
                      LogicalName="Backend.Insights.Export.run-export-v1.schema.json" />
    <Content Include="data/sql/insights_seed.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data/sql/insights_stress_seed.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data/sql/benchmark_schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="data/seed/insights_stress_corpus.json"
             TargetPath="data/seed/insights_stress_corpus.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
